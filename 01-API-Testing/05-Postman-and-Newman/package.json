{
  "name": "postman-newman-practice",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "newman run collections/qa-practice.postman_collection.json -e collections/qa-practice.postman_environment.json",
    "test:data": "newman run collections/qa-practice.postman_collection.json -e collections/qa-practice.postman_environment.json --folder \"07 Data-driven — one request, many CSV rows\" -d data/posts-data.csv",
    "test:html": "newman run collections/qa-practice.postman_collection.json -e collections/qa-practice.postman_environment.json -r cli,htmlextra --reporter-htmlextra-export reports/report.html",
    "test:ci": "newman run collections/qa-practice.postman_collection.json -e collections/qa-practice.postman_environment.json -r cli,junit --reporter-junit-export reports/junit.xml"
  },
  "devDependencies": {
    "newman": "^6.2.1",
    "newman-reporter-htmlextra": "^1.23.1"
  }
}
